{
  "name": "avtopark",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typeorm": "ts-node -P tsconfig.typeorm.json -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d src/lib/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "seed:test-users": "ts-node -P tsconfig.typeorm.json -r tsconfig-paths/register src/scripts/seed-test-users.ts",
    "seed:admin": "ts-node -P tsconfig.typeorm.json -r tsconfig-paths/register src/scripts/seed-admin.ts",
    "seed:demo": "ts-node -P tsconfig.typeorm.json -r tsconfig-paths/register src/scripts/seed-demo.ts",
    "seed:parts": "ts-node -P tsconfig.typeorm.json -r tsconfig-paths/register src/scripts/seed-parts.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-query-devtools": "^5.104.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.7",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "mysql2": "^3.24.6",
    "next": "^16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "pdfmake": "^0.3.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hot-toast": "^2.6.1",
    "react-qr-code": "^2.2.0",
    "react-to-print": "^3.3.0",
    "recharts": "^3.10.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/html2pdf.js": "^0.10.0",
    "@types/node": "^20",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5"
  }
}
